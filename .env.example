# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Every value here is optional -- the site builds and runs with none of them.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, sitemap, robots and OG metadata.
# Leave unset locally; set it to your real domain in production.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# AI PROJECT FIT ANALYZER
#
# GEMINI_API_KEY is a SERVER-ONLY secret. It is read exclusively inside
# src/lib/ai/gemini.ts, which only ever runs in a route handler. There is no
# NEXT_PUBLIC_ variant and there must never be one -- a NEXT_PUBLIC_ prefix
# would inline the key into the browser bundle.
#
# Get a key at https://aistudio.google.com/apikey
#
# Leave GEMINI_API_KEY empty to disable the feature: the section is not
# rendered and the API route returns 503.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
