# ---------------------------------------------------------------------------
# Production build values. Committed on purpose: this file holds no secrets,
# only the public canonical origin.
#
# `NEXT_PUBLIC_*` values are inlined at BUILD time, so this has to be set here
# rather than as a Worker variable — canonical URLs, the sitemap and robots.txt
# are all baked into the prerendered HTML.
#
# Replace this with your own domain when you have one, then rebuild and deploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://buildwith.omor.workers.dev
